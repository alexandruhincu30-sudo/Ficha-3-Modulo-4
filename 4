#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <string.h>
#define MAX 80

int main()
{
	char texto[MAX + 1];
	int eliminacoes = 0;
	char letra;
	int len;
	int idx = 0;
	int i;
	gets(texto);
	printf("Insira uma letra: ");
	scanf(" %c", &letra);
	texto[MAX] = '\0';


	while (texto[idx] != '\0')
	{
		if (texto[idx] == letra)
		{
		
			eliminacoes++;
			for (i = idx; texto[i] != '\0'; i++)
				texto[i] = texto[i + 1];

		}
		else
		{
			idx++;
		}
	}

	printf("Numero de eliminacoes: %d\n", eliminacoes);
	printf("Texto alterado: %s\n", texto);

	return 0;
}
