#include <stdio.h>
#include <string.h>
#define MAX 10
int atoi(char *str);

int main() {
	char entrada[MAX+1]; 
	int numero;

	printf("Digite uma string representativa de um numero inteiro (max. 10 caracteres):");
	gets(entrada);

	numero = atoi(entrada);
	entrada[MAX]='\0';
	printf("Copia atoi: %d\n", numero);


	return 0;
}

int atoi(const char *str)
{
	int resultado = 0;
	int sinal = 1;
	int i = 0;

	if (str[i] == '-') {
		sinal = -1;
		i++;
	} 
	else
		if (str[i] == '+')
		{
			i++;
		}


		while (str[i] != '\0')
		{
			resultado = resultado * 10 + (str[i] - '0');
			i++;
		}

		return resultado * sinal;
}
